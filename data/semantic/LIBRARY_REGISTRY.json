    {
      "from": "anarchism",
      "to": "ci_cd",
      "type": "cross_library_analogy_not_equivalence",
      "note": "Descentralización y coordinación distribuida pueden compararse; no implican identidad entre teoría política y arquitectura técnica."
    },
    {
      "from": "cooperation",
      "to": "engineering",
      "type": "cross_domain_bridge",
      "note": "Cooperación como patrón social y coordinación de componentes; analogía, no equivalencia."
    },
    {
      "from": "epistemology",
      "to": "anarchism",
      "type": "cross_domain_bridge",
      "note": "Crítica de autoridad y evaluación de justificaciones; no asumir que una postura política determina la verdad."
    },
    {
      "from": "science",
      "to": "anarchism",
      "type": "historical_theme",
      "note": "Materialismo y educación científica aparecen en autores clásicos; tratar como posiciones históricas debatibles."
    },
    {
      "from": "self_organization",
      "to": "systems",
      "type": "cross_domain_bridge",
      "note": "Autoorganización como concepto común en sistemas sociales y técnicos."
    },
    {
      "from": "science",
      "to": "empiricism",
      "type": "methodological_connection",
      "note": "Observation and evidence connect scientific practice to philosophical accounts of knowledge."
    },
    {
      "from": "biology",
      "to": "cooperation",
      "type": "cross_domain_bridge",
      "note": "Biological accounts of cooperation can inform social analysis without reducing social institutions to biology."
    },
    {
      "from": "division_of_labor",
      "to": "cooperation",
      "type": "cross_domain_bridge",
      "note": "Specialization can increase interdependence while also creating coordination and power questions."
